{
  "name": "@featureflip/js",
  "version": "2.10.0",
  "description": "JavaScript/TypeScript SDK for Featureflip",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/canopy-labs/featureflip-js.git"
  },
  "homepage": "https://featureflip.io/docs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.node.d.ts",
      "node": {
        "import": "./dist/node.mjs",
        "require": "./dist/node.cjs"
      },
      "browser": {
        "import": "./dist/browser.mjs",
        "require": "./dist/browser.cjs"
      },
      "default": "./dist/browser.mjs"
    }
  },
  "types": "./dist/index.node.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "eventsource": "^5.1.1"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@typescript/typescript6": "^6.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "lodash": ">=4.17.25"
  }
}
